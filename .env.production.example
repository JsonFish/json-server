# 生产环境配置模板
#
# 使用方式：
#   cp .env.production.example .env.production
#   然后填入真实值。.env.production 已在 .gitignore 中，不要提交。
#
# 生成随机密钥：
#   openssl rand -hex 32

# ---- 运行模式 ----
# 必须为 production：缺失的关键配置会直接拒绝启动，避免带着占位密钥上线。
NODE_ENV=production
PORT=3001

# 前端域名白名单，多个用英文逗号分隔。生产环境必填且不允许用 *。
# 例如：https://blog.example.com,https://www.example.com
CORS_ORIGIN=https://blog.example.com

# 接口文档默认仅在非生产环境暴露。确需在生产开启时设为 true，
# 但请务必自行加上访问控制，否则会向公网公开完整写接口清单。
SWAGGER_ENABLED=false

# ---- JWT 密钥（必填，生产环境缺失即拒绝启动）----
# 换掉后所有已签发的 access/refresh token 会立即失效，用户需重新登录。
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# ---- GitHub OAuth（必填，生产环境缺失即拒绝启动）----
# 在 https://github.com/settings/developers 新建 OAuth App，
# Homepage URL 与 Authorization callback URL 分别填你的站点地址，
# 前端登录时用的 redirect_uri 必须与之一致。
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---- MySQL（必填）----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=jsonserver
DB_PASSWORD=
DB_DATABASE=jsonfi

# 每个 Node 进程的连接池上限。
# 集群模式下总连接数 ≈ PM2_INSTANCES × DB_POOL_SIZE，必须小于 MySQL 的 max_connections。
DB_POOL_SIZE=10
DB_RETRY_ATTEMPTS=5
DB_RETRY_DELAY=3000

# ---- 限流（每 IP 每分钟）----
# 全局默认值，以及 /auth/github 登录接口的专用阈值。
THROTTLE_LIMIT=120
AUTH_THROTTLE_LIMIT=10
